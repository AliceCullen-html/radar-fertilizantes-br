# Copie para .env e preencha localmente. O .env NUNCA é versionado.
# Os valores são lidos SOMENTE de variáveis de ambiente (ex.: set -a; . ./.env; set +a).
# Nenhuma variável é obrigatória para rodar os testes ou o boletim em modo --mock.

# Opcional: arquivo PEM ou DER com CAs extras (ex.: cadeia ICP-Brasil), somado ao
# bundle padrão na verificação TLS da API do Comex Stat.
COMEXSTAT_CA_BUNDLE=

# --- Fase 5: boletim com IA (opcional; traga a sua chave) ---------------------------
# Provedor: anthropic (padrão), openai (qualquer API compatível com OpenAI) ou ollama (local).
RADAR_LLM_PROVIDER=
# Modelo. Padrão para anthropic: claude-sonnet-5-5. Para openai e ollama é obrigatório.
RADAR_LLM_MODEL=

# anthropic: chave da API da Anthropic.
ANTHROPIC_API_KEY=

# openai: chave e endereço da API compatível (padrão: https://api.openai.com/v1).
# Num servidor local compatível, a chave pode ficar vazia.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# ollama: endereço do servidor local, sem chave (padrão: http://localhost:11434).
OLLAMA_HOST=
